# 可选：Socket 服务地址。不设置则使用 Mock 模式（无需后端即可体验）
# VITE_SOCKET_URL=http://127.0.0.1:23256

# ---------- 后端 (server/) ----------
# 后端端口，需与 vite.config.js 里 proxy /api 的 target 一致
# PORT=3000
# JWT 密钥，生产环境务必修改
# JWT_SECRET=your-secret-key
# 登录账号，格式：账号1:密码1,账号2:密码2（无注册，仅此处配置的账号可登录）
# FOXTRPG_USERS=admin:123456
